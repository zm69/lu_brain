            }
        },
        {
            "label": "Semeion Eval",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "type": "shell",
            "isBackground": false,
            "command": "odin",
            "args": [
                "run",
                "${workspaceFolder}/samples/semeion_eval",
                "-o:speed",
                "-out:out/eval.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/samples/semeion_eval/"
            },
            "presentation": {
                "echo": true,
